# Template — rendered by scripts/render-nginx.sh from deployment/.env.
# Upstream bind addresses + ports come from the same vars docker-compose uses, so
# nginx always points at the port the container was actually published on.
# Every brace-style variable (dollar + {NAME}) is substituted and must be set
# in .env; nginx's own $vars ($host, $remote_addr, ...) are left untouched.

# ==========================================
# 1. HTTP → HTTPS
# ==========================================
server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};

    return 301 https://$host$request_uri;
}

# ==========================================
# 2. Frontend + Backend API (HTTPS)
# ==========================================
server {
    listen 443 ssl;
    server_name ${NGINX_SERVER_NAME};

    # تنظیمات گواهینامه SSL (مسیرها از .env)
    ssl_certificate     ${NGINX_SSL_CERTIFICATE};
    ssl_certificate_key ${NGINX_SSL_CERTIFICATE_KEY};

    # تنظیمات امنیتی پیشنهادی SSL
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;

    # هدایت ترافیک مسیر /api به سرویس بک‌اند داکر (server)
    # با اسلش انتهای proxy_pass، پیشوند /api حذف می‌شود: /api/v1/... → /v1/...
    location /api/ {
        proxy_pass http://${SERVER_BIND_ADDRESS}:${SERVER_HOST_PORT}/;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # تنظیمات مناسب برای وب‌سوکت یا کانکشن‌های طولانی
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # فرانت‌اند (Vite SPA بدون base path) از ریشه سرو می‌شود؛
    # مسیرهای SPA و /assets/ را nginx داخل کانتینر frontend پاسخ می‌دهد.
    location / {
        proxy_pass http://${FRONTEND_BIND_ADDRESS}:${FRONTEND_HOST_PORT};

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
