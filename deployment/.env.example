# deployment/.env — read by docker compose, the scripts (build args, nginx
# template) and, through env_file, by every server container.
# cp .env.example .env and fill in passwords / secrets. Never commit .env.

# ============================================================================
# Deployment
# ============================================================================
# Image tags used by docker-compose.yml. `make deploy` (local mode) rewrites
# them to <image>:local and adds <IMAGE>_SHA; set them by hand for --mode images.
TDLIB_IMAGE=tdlib:latest
SERVER_IMAGE=server:latest
FRONTEND_IMAGE=frontend:latest

# Branch pulled by `make deploy` in local mode (server and frontend live in the
# same clone, so it is pulled once with the first branch that applies).
# SERVER_BRANCH=main
# FRONTEND_BRANCH=main

# Optional base image overrides for the server/tdlib builds (when the default
# registry is unreachable). Leave commented to keep the Dockerfile defaults.
# GO_IMAGE=golang:1.26-bookworm
# RUNTIME_IMAGE=debian:bookworm-slim
# TDLIB_REF=master

# ============================================================================
# Host nginx (nginx/gatec.conf.template)
# ============================================================================
NGINX_SERVER_NAME=gatec.ir
NGINX_SSL_CERTIFICATE=/etc/nginx/ssl/gatec.ir.crt
NGINX_SSL_CERTIFICATE_KEY=/etc/nginx/ssl/gatec.ir.key

# ============================================================================
# Infra (published on 127.0.0.1 only)
# ============================================================================
NATS_HOST_PORT=9022
NATS_MONITOR_HOST_PORT=9023
POSTGRES_HOST_PORT=9032
CLICKHOUSE_NATIVE_HOST_PORT=9042
CLICKHOUSE_HTTP_HOST_PORT=9043

# Host address:port docker publishes ch-ui on (reach it with an SSH tunnel).
CH_UI_BIND_ADDRESS=127.0.0.1
CH_UI_HOST_PORT=9052

# ============================================================================
# Frontend
# ============================================================================
# Host address:port docker publishes the frontend on; nginx proxies / here.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_HOST_PORT=8091
# Backend URL baked into the frontend bundle at build time (browser-facing).
# nginx strips /api, so the server sees /v1/...
NEXT_PUBLIC_API_BASE_URL=https://gatec.ir/api

# ============================================================================
# Server (gatec) — every key below must exist (configs.Load panics otherwise)
# ============================================================================
APP_ENV=production
APP_DEBUG=false
LOCALE=fa
HEALTH_TOKEN=change-me
SERVER_ADDR=0.0.0.0
SERVER_PORT=8575
# Host address:port docker publishes the server on; nginx proxies /api/ here.
SERVER_BIND_ADDRESS=127.0.0.1
SERVER_HOST_PORT=8575
GIN_MODE=release
LOG_LEVEL=info
# Overridden per service in docker-compose.yml (/app/logs/<service>.log).
LOG_FILE=/app/logs/gatec.log

# Containers reach infra by compose service name.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=gatec
POSTGRES_PASSWORD=change-me
POSTGRES_DB_NAME=gatec
DB_TYPE=postgreSQL
IS_SSL_ENABLE=false

CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DATABASE=gatec
CLICKHOUSE_USER=gatec
CLICKHOUSE_PASSWORD=change-me

NATS_URL=nats://nats:4222
NATS_WORKER_STREAM=GATEC_WORKERS
NATS_CANDLE_SUBJECT=market.candle.updated
NATS_CANDLE_SNAPSHOT_SUBJECT=market.candle.indicators
NATS_WORKER_CONSUMER_PREFIX=gatec-indicator
WORKER_SIGNAL_STRATEGY_SOURCE=both
WORKER_SIGNAL_STRATEGIES_DIR=strategies
WORKER_SIGNAL_POLL_INTERVAL=2s
WORKER_SIGNAL_MAX_EVENT_AGE=0s
WORKER_SIGNAL_SHARDS=4
WORKER_SIGNAL_FAILURE_THRESHOLD=3
WORKER_SIGNAL_WARMUP_MARGIN=2
WORKER_SIGNAL_STATE_CAPACITY=100

# Key files live in deployment/server/secrets/ (mounted read-only).
JWT_PUBLIC_KEY_PATH=/app/configs/secrets/jwt_public.pem
JWT_PRIVATE_KEY_PATH=/app/configs/secrets/jwt_private.pem
SIGNING_METHOD=rs256

ADAPTER_NOBITEX_API_BASE_URL=
ADAPTER_NOBITEX_SOCKET_URL=
ADAPTER_NOBITEX_MAX_CONNECTION=
ADAPTER_NOBITEX_MAX_CHANNEL_PER_CONNECTION=
WORKER_INDICATOR_CRYPTO_P0_ENABLED=true
WORKER_INDICATOR_ATR_PCT_PERIOD=14
WORKER_INDICATOR_DONCHIAN_PERIOD=20
WORKER_INDICATOR_ROC_PERIOD_SHORT=6
WORKER_INDICATOR_ROC_PERIOD_LONG=12
WORKER_INDICATOR_MFI_PERIOD=14
WORKER_INDICATOR_BOLLINGER_PERIOD=20
WORKER_INDICATOR_BOLLINGER_DEVIATION=2
ADAPTER_TABDEAL_API_BASE_URL=
ADAPTER_TABDEAL_AUTH_TOKEN=

# Daily current TSETMC snapshot, scheduled in Asia/Tehran time.
WORKER_TSE_MARKET_DAILY_SYNC_SCHEDULE_HOUR=20
WORKER_TSE_MARKET_DAILY_SYNC_SCHEDULE_MIN=21
WORKER_TSE_MARKET_DAILY_SYNC_REQUEST_INTERVAL=250ms
WORKER_TSE_MARKET_DAILY_SYNC_TELEGRAM_BOT_TOKEN=
WORKER_TSE_MARKET_DAILY_SYNC_REPORT_CHAT_ID=

WORKER_INDICATOR_CALCULATOR_EXECUTION_ITTRATION_DURATION=
WORKER_SIGNAL_CHECKER_EXECUTION_ITTRATION_DURATION=

# Stock sync. Historical dates are inclusive and processed backwards.
# Modes: daily, historical.
WORKER_STOCK_MARKET_SYNC_PROVIDER_ID=0
WORKER_STOCK_MARKET_SYNC_MODE=daily
WORKER_STOCK_MARKET_SYNC_SCHEDULE_HOUR=16
WORKER_STOCK_MARKET_SYNC_SCHEDULE_MIN=0
WORKER_STOCK_MARKET_SYNC_HISTORICAL_START_DATE=1404/07/12
WORKER_STOCK_MARKET_SYNC_HISTORICAL_END_DATE=1400/01/01
WORKER_STOCK_MARKET_SYNC_REQUEST_INTERVAL=1m

TSE_MARKET_DATA_SYNC_MODE=
TSE_MARKET_DATA_SYNC_COLLECTION_METHOD=all
TSE_MARKET_DATA_SYNC_INS_CODES=
TSE_MARKET_DATA_SYNC_DATE=
TSE_MARKET_DATA_SYNC_START_DATE=
TSE_MARKET_DATA_SYNC_END_DATE=
TSE_MARKET_DATA_SYNC_REQUEST_INTERVAL=
TSE_MARKET_DATA_SYNC_SCHEDULE_HOUR=21
TSE_MARKET_DATA_SYNC_SCHEDULE_MIN=0

WORKER_TSE_MARKET_WATCH_START_HOUR=8
WORKER_TSE_MARKET_WATCH_START_MIN=30
WORKER_TSE_MARKET_WATCH_END_HOUR=23
WORKER_TSE_MARKET_WATCH_END_MIN=00
WORKER_TSE_MARKET_WATCH_POLL_INTERVAL=10s

WORKER_TSE_INSTRUMENT_SYNC_SINGLE_CHECK=false
WORKER_TSE_INSTRUMENT_SYNC_INTERVAL_DAYS=7
WORKER_TSE_INSTRUMENT_SYNC_SCHEDULE_HOUR=8
WORKER_TSE_INSTRUMENT_SYNC_SCHEDULE_MIN=0

SERVICE_AUTH_BCRYPT_COST=
SERVICE_AUTH_EXPIRATION_TIME=
SERVICE_AUTH_HASHING_SALT=
SERVICE_TELEGRAM_API_ID=
SERVICE_TELEGRAM_API_HASH=
SERVICE_TELEGRAM_AUTH_TIMEOUT=
# Shared by server, airdrop-catcher and some workers (./server/tdlib).
SERVICE_TELEGRAM_DATABASE_DIR=/app/.tdlib2
