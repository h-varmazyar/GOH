    {
      "parameters": {
        "jsCode": "function parseDate(str) {\n  if (!str  || !/^\\d{8}$/.test(str)) {\n    throw new Error(`فرمت تاریخ نامعتبر: ${str} (باید YYYYMMDD باشد)`);\n  }\n\n  const year  = parseInt(str.substring(0, 4), 10);\n  const month = parseInt(str.substring(4, 6), 10) - 1;\n  const day   = parseInt(str.substring(6, 8), 10);\n\n  const date = new Date(year, month, day);\n\n  // بررسی اینکه تاریخ واقعاً معتبر است (مثلاً ماه 13 وجود ندارد)\n  if (date.getFullYear() !== year || \n      date.getMonth() !== month || \n      date.getDate() !== day) {\n    throw new Error(`تاریخ نامعتبر: ${str}`);\n  }\n\n  return date;\n}\n\nvar resp = [];\nconst now = new Date().toISOString();\nfor (let index = 0; index < $input.all().length; index++) {\n  const item = $input.all()[index];\n  if (item.json.instrumentState.length>0) {\n    resp.push({\n      \"insCode\":item.json.instrumentState[0].insCode,\n      \"status\":\"tradeable\",\n      \"symbolStatus\":item.json.instrumentState[0].cEtaval,\n      \"statusUpdatedAt\":parseDate(item.json.instrumentState[0].dEven+\"\")\n    })\n  }else{\n    resp.push({\n      \"insCode\":$('Select rows from a table').all()[index].json.ins_code,\n      \"status\":\"untradeable\",\n      \"symbolStatus\":\"N/A\",\n      \"statusUpdatedAt\":now,\n    })\n  }\n}\n\nreturn resp;"
      },
