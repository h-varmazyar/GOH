    },
    {
      "parameters": {
        "jsCode": "const symbolType= {\n  \"300\":\"سهام عادی - بورس\",\n  \"303\":\"سهام عادی - فرابورس\",\n  \"307\":\"سهام عادی - تسهیلات فرابورس\",\n  \"309\":\"سهام عادی - پایه فرابورس\",\n  \"313\":\"سهام عادی - شرکت های کوچک و متوسط فرابورس\",\n  \"400\":\"حق تقدم - بورس\",\n  \"403\":\"حق تقدم - فرابورس\",\n  \"404\":\"حق تقدم - پایه فرابورس\",\n  \"401\":\"حق تقدم - شرکت های کوچک و متوسط قرابورس\",\n  \"402\":\"اوراق مشارکت - مظنه یابی\",\n  \"208\":\"اوراق مشارکت - اوراق صکوک\",\n  \"706\":\"اوراق مشارکت - صکوک اختصاصی\",\n  \"306\":\"اوراق مشارکت - اوراق مشارکت فرابورس\",\n  \"305\":\"صندوق های سرمایه گذاری قابل معامله در بورس\",\n}\n\nconst marketStatus = {\n  1:\"tradeable\",\n  0: \"untradeable\",\n}\n\nconst symbolStatus = {\n  \"I\":\"ممنوع\",\n  \"A\":\"مجاز\",\n  \"AG\":\"مجاز - مسدود\",\n  \"AS\":\"مجاز - متوقف\",\n  \"AR\":\"مجاز - محفوظ\",\n  \"IG\":\"ممنوع - مسدود\",\n  \"IS\":\"ممنوع - متوقف\",\n  \"IR\":\"ممنوع - محفوظ\",\n}\n\nconst marketType = {\n  1:\"بورس\",\n  2:\"فرابورس\",\n  3:\"آتی\",\n  4:\"پایه فرابورس\",\n  6:\"بورس انرژی\",\n  7:\"بورس کالا\",\n}\n\nfunction safeTrim(value) {\n  if (value === null || value === undefined) {\n    return null;\n  }\n  return String(value).trim();\n}\n\nvar response = [];\nfor (const data of $input.all()) {\n  const instruments = data.json.data.items[0].instruments;\n  for (const item of instruments) {\n    response.push({\n    \"ins_code\":item.insCode,\n    \"label\":item.smallSymbolName,\n    \"name\":item.symbolFullName,\n    \"group\":safeTrim(item.industryGroupCode),\n    \"sub_group\":item.industrySubCode,\n    \"symbol_status\":symbolStatus[item.symbolStatus],\n    \"symbol_type\":symbolType[item.type],\n    \"market_type\":marketType[item.marketCode],\n    \"status\":marketStatus[item.status],\n    \n  })\n  }\n}\nreturn response;"
      },
